###########
# General #
###########
quit-after-last-window-closed = true

##########
# Colors #
##########
theme = dark:Rose Pine Moon,light:Rose Pine Dawn

########
# Font #
########
font-family = "FiraCode Nerd Font Ret"
font-style-italic = false
font-style-bold-italic = false
font-size = 13
font-thicken = true
font-thicken-strength = 200
font-feature = -calt,-liga,-dlig
font-synthetic-style = no-bold,no-italic,no-bold-italic

##########
# Cursor #
##########
cursor-style = bar
cursor-style-blink = true

##########
# Window #
##########
fullscreen = true
window-theme = ghostty
title = " "
bell-features = no-system,no-audio,no-attention,no-title,no-border
# window-decoration = none

#########
# MacOS #
#########
macos-icon = "glass"
macos-option-as-alt = true
# macos-titlebar-proxy-icon = hidden
# macos-window-buttons = hidden
